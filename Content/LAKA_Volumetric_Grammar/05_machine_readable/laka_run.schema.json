{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAKA Run — Proposed v1.0 Draft Structure",
  "description": "Structural data contract for a LAKA run. It does not validate causality, novelty, feasibility, evidence quality, or forecast accuracy.",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0-draft"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "GENERATE",
        "SOLVE",
        "DECODE",
        "PREDICT",
        "PLAN",
        "POSITION"
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_desire": {
          "type": [
            "string",
            "null"
          ]
        },
        "desired_outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_horizon": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "actor",
        "scenario",
        "purpose",
        "current_desire",
        "desired_outcome",
        "time_horizon",
        "as_of"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "Object": {
          "type": [
            "string",
            "null"
          ]
        },
        "Conditions": {
          "type": [
            "string",
            "null"
          ]
        },
        "Actions": {
          "type": [
            "string",
            "null"
          ]
        },
        "Tools": {
          "type": [
            "string",
            "null"
          ]
        },
        "Resources": {
          "type": [
            "string",
            "null"
          ]
        },
        "Outcomes": {
          "type": [
            "string",
            "null"
          ]
        },
        "Feedback": {
          "type": [
            "string",
            "null"
          ]
        },
        "Constraints": {
          "type": [
            "string",
            "null"
          ]
        },
        "Value": {
          "type": [
            "string",
            "null"
          ]
        },
        "Failure mode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "Object",
        "Conditions",
        "Actions",
        "Tools",
        "Resources",
        "Outcomes",
        "Feedback",
        "Constraints",
        "Value",
        "Failure mode"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "observed",
              "source_claim",
              "inferred",
              "assumed",
              "hypothetical"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "statement",
          "source",
          "locator"
        ],
        "additionalProperties": false
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "hypothetical",
              "ready_to_test",
              "tested_in_stated_conditions",
              "rejected"
            ]
          },
          "system_sentence": {
            "type": "string",
            "minLength": 1
          },
          "system": {
            "type": "object",
            "properties": {
              "Object": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Conditions": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Actions": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Tools": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Resources": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Outcomes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Feedback": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Constraints": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Failure mode": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "Object",
              "Conditions",
              "Actions",
              "Tools",
              "Resources",
              "Outcomes",
              "Feedback",
              "Constraints",
              "Value",
              "Failure mode"
            ],
            "additionalProperties": false
          },
          "transformations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "coordinate": {
                  "type": "object",
                  "properties": {
                    "change_code": {
                      "enum": [
                        "C0",
                        "C1",
                        "C2",
                        "C3",
                        "C4"
                      ]
                    },
                    "internal_code": {
                      "enum": [
                        "I01",
                        "I02",
                        "I03",
                        "I04",
                        "I05",
                        "I06",
                        "I07",
                        "I08",
                        "I09",
                        "I10"
                      ]
                    },
                    "meta_code": {
                      "enum": [
                        "M01",
                        "M02",
                        "M03",
                        "M04",
                        "M05",
                        "M06",
                        "M07",
                        "M08",
                        "M09",
                        "M10",
                        "M11",
                        "M12",
                        "M13",
                        "M14"
                      ]
                    }
                  },
                  "required": [
                    "change_code",
                    "internal_code",
                    "meta_code"
                  ],
                  "additionalProperties": false
                },
                "current_state": {
                  "type": "string",
                  "minLength": 1
                },
                "target_state": {
                  "type": "string",
                  "minLength": 1
                },
                "operators": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "SHIFT",
                      "ROTATE",
                      "INVERT",
                      "TRANSFER",
                      "SUBSTITUTE",
                      "SPLIT",
                      "MERGE",
                      "COUPLE",
                      "DECOUPLE",
                      "STABILIZE",
                      "DESTABILIZE",
                      "SEQUENCE",
                      "PARALLELIZE",
                      "RECURSE",
                      "OVERLAY",
                      "PRUNE",
                      "COMPOSE"
                    ]
                  }
                },
                "mechanism": {
                  "type": "string",
                  "minLength": 1
                },
                "classification_reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "id",
                "coordinate",
                "current_state",
                "target_state",
                "operators",
                "mechanism",
                "classification_reason",
                "evidence_ids"
              ],
              "additionalProperties": false
            }
          },
          "expected_outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "direction": {
                  "type": "string",
                  "minLength": 1
                },
                "threshold": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "statement",
                "metric",
                "unit",
                "direction",
                "threshold"
              ],
              "additionalProperties": false
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hypothesis": {
                  "type": "string",
                  "minLength": 1
                },
                "measurement": {
                  "type": "string",
                  "minLength": 1
                },
                "success_rule": {
                  "type": "string",
                  "minLength": 1
                },
                "stop_rule": {
                  "type": "string",
                  "minLength": 1
                },
                "rollback": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "hypothesis",
                "measurement",
                "success_rule",
                "stop_rule",
                "rollback"
              ],
              "additionalProperties": false
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "system_sentence",
          "system",
          "transformations",
          "expected_outcomes",
          "dependencies",
          "tests",
          "evidence_ids",
          "uncertainty"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "run_id",
    "mode",
    "context",
    "baseline",
    "evidence",
    "concepts",
    "notes"
  ],
  "additionalProperties": false
}
